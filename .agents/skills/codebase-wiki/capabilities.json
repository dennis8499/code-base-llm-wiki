{
  "contract_version": 5,
  "surfaces": ["copilot", "codex"],
  "guard_modes": {
    "default": "wiki-only",
    "installed": ["wiki-only", "coexist"],
    "legacy_alias": {"target": "wiki-only"},
    "framework": "framework"
  },
  "intents": {
    "install": {
      "writes_by_default": false,
      "requires_confirmation": true,
      "authorization_policy": "apply_flag"
    },
    "ingest": {
      "writes_by_default": false,
      "requires_confirmation": true,
      "authorization_policy": "interactive_preview_or_explicit_batch"
    },
    "query": {
      "writes_by_default": false,
      "requires_confirmation": false,
      "authorization_policy": "read_only"
    },
    "lint": {
      "writes_by_default": false,
      "requires_confirmation": true,
      "authorization_policy": "confirm_repairs"
    },
    "archaeology": {
      "writes_by_default": false,
      "requires_confirmation": true,
      "authorization_policy": "explicit_persist"
    },
    "adr": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request"
    },
    "synthesis": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request"
    },
    "business_analysis": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request"
    },
    "system_analysis": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request"
    },
    "system_design": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request"
    },
    "notebooklm_export": {
      "writes_by_default": false,
      "requires_confirmation": true,
      "authorization_policy": "preview_then_confirm",
      "confirmation_stages": ["discovery_plan", "readiness_apply"],
      "audience": "business-analyst",
      "knowledge_contract": "business-knowledge-v1"
    }
  },
  "intent_groups": {
    "install_setup": ["install"],
    "ingest": ["ingest"],
    "query": ["query"],
    "lint": ["lint"],
    "adr": ["adr"],
    "synthesis": ["synthesis"],
    "business_analysis": ["business_analysis"],
    "system_analysis": ["system_analysis"],
    "system_design": ["system_design"],
    "notebooklm_export": ["notebooklm_export"],
    "archaeology": ["archaeology"]
  },
  "entrypoints": {
    "copilot": {
      "install": [],
      "ingest": ["ingest-module.prompt.md", "ingest-batch.prompt.md"],
      "query": ["query-wiki.prompt.md"],
      "lint": ["lint-wiki.prompt.md"],
      "archaeology": ["code-archaeology.prompt.md"],
      "adr": ["new-adr.prompt.md"],
      "synthesis": ["save-synthesis.prompt.md"],
      "business_analysis": ["business-analysis-doc.prompt.md"],
      "system_analysis": ["system-analysis-doc.prompt.md"],
      "system_design": ["system-design-doc.prompt.md"],
      "notebooklm_export": ["export-notebooklm.prompt.md"]
    },
    "codex": {
      "recipe_document": "Codex.md"
    }
  },
  "cli": {
    "install": "python .agents/skills/codebase-wiki/scripts/install-framework.py install --target TARGET --surface SURFACE --guard-mode wiki-only",
    "upgrade": "python .agents/skills/codebase-wiki/scripts/install-framework.py upgrade --target TARGET --surface SURFACE --guard-mode wiki-only"
  }
}
