{
  "contract_version": 7,
  "surfaces": [
    "copilot",
    "codex"
  ],
  "guard_modes": {
    "default": "wiki-only",
    "installed": [
      "wiki-only",
      "coexist"
    ],
    "legacy_alias": {
      "target": "wiki-only"
    },
    "framework": "framework"
  },
  "intents": {
    "install": {
      "writes_by_default": false,
      "requires_confirmation": true,
      "authorization_policy": "apply_flag"
    },
    "ingest": {
      "writes_by_default": false,
      "requires_confirmation": true,
      "authorization_policy": "interactive_preview_or_explicit_batch",
      "modes": [
        "single-path",
        "all-project"
      ],
      "coverage_validator": "scripts/ingest-coverage.py",
      "coverage_ledger": "wiki/ingest-coverage.json"
    },
    "query": {
      "writes_by_default": false,
      "requires_confirmation": false,
      "authorization_policy": "read_only"
    },
    "lint": {
      "writes_by_default": false,
      "requires_confirmation": true,
      "authorization_policy": "confirm_repairs"
    },
    "code_audit": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request",
      "checks": [
        "transaction_consistency",
        "configuration_reference_consistency",
        "logic_state_consistency",
        "change_regression"
      ],
      "finding_classes": [
        "BUG",
        "RISK",
        "BIZ"
      ],
      "review_unit": "functional_capability_with_entrypoint_coverage",
      "report_version": 4,
      "legacy_report_versions": [
        2,
        3
      ],
      "scan_schema_version": 2,
      "scan_profiles": [
        "target",
        "framework"
      ],
      "scanner": ".agents/skills/codebase-wiki/scripts/scan-project.py",
      "inventory_contract": "file_hash_category_disposition_snapshot",
      "functional_review": [
        "normal_and_boundary_scenarios",
        "validation_authorization_and_security",
        "state_transactions_side_effects_and_idempotency",
        "configuration_compatibility_performance_and_observability"
      ],
      "rerun_states": [
        "new",
        "still-present",
        "rechecked-no-longer-observed",
        "not-rechecked"
      ],
      "severity_scale": "P0-P3",
      "impact_order": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "finding_examples": [
        "plain_language_explanation",
        "operation_input_expected_actual_result",
        "code_derived_not_executed_marker"
      ],
      "merge_parent_review": [
        "compare_each_parent_to_merge_result",
        "check_validation_authorization_error_handling_configuration_and_transformation",
        "confirm_issue_survives_in_current_source",
        "do_not_attribute_squash_rebase_or_copy_to_manual_merge"
      ],
      "history": {
        "mode": "current_first_targeted",
        "commands": [
          "git log",
          "git show",
          "git blame"
        ],
        "read_only": true
      },
      "report_validator": ".agents/skills/codebase-wiki/scripts/validate-code-audit.py"
    },
    "archaeology": {
      "writes_by_default": false,
      "requires_confirmation": true,
      "authorization_policy": "explicit_persist"
    },
    "adr": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request"
    },
    "synthesis": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request"
    },
    "visualize": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request",
      "workflow": "references/visualization-workflow.md",
      "commands": ["prepare", "publish", "verify"],
      "types": ["architecture", "workflow", "sequence", "dataflow", "lifecycle", "erd", "class", "tree", "timeline", "waterfall"],
      "publish_gates": ["validate", "deliver", "check", "browser-check"],
      "publish_only_after_all_gates_pass": true
    },
    "business_analysis": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request"
    },
    "system_analysis": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request"
    },
    "system_design": {
      "writes_by_default": true,
      "requires_confirmation": false,
      "authorization_policy": "explicit_request"
    },
    "notebooklm_export": {
      "writes_by_default": false,
      "requires_confirmation": true,
      "authorization_policy": "preview_then_confirm",
      "confirmation_stages": [
        "discovery_plan"
      ],
      "audience": "business-and-system-analyst",
      "knowledge_contract": "codebase-ba-sa-v1"
    },
    "functional_exploration": {
      "writes_by_default": false,
      "requires_confirmation": false,
      "authorization_policy": "explicit_persist",
      "source_order": "current_source_first",
      "report_schema": "codebase-functional-exploration/v1",
      "scanner": ".agents/skills/codebase-wiki/scripts/explore-functions.py",
      "coverage": "all_included_files_and_entrypoint_candidates"
    }
  },
  "intent_groups": {
    "install_setup": [
      "install"
    ],
    "ingest": [
      "ingest"
    ],
    "query": [
      "query"
    ],
    "lint": [
      "lint"
    ],
    "code_audit": [
      "code_audit"
    ],
    "adr": [
      "adr"
    ],
    "synthesis": [
      "synthesis"
    ],
    "business_analysis": [
      "business_analysis"
    ],
    "system_analysis": [
      "system_analysis"
    ],
    "system_design": [
      "system_design"
    ],
    "notebooklm_export": [
      "notebooklm_export"
    ],
    "archaeology": [
      "archaeology"
    ],
    "functional_exploration": [
      "functional_exploration"
    ],
    "visualize": [
      "visualize"
    ]
  },
  "entrypoints": {
    "copilot": {
      "install": [],
      "ingest": [
        "ingest-module.prompt.md",
        "ingest-batch.prompt.md"
      ],
      "query": [
        "query-wiki.prompt.md"
      ],
      "lint": [
        "lint-wiki.prompt.md"
      ],
      "code_audit": [
        "code-audit.prompt.md"
      ],
      "archaeology": [
        "code-archaeology.prompt.md"
      ],
      "adr": [
        "new-adr.prompt.md"
      ],
      "synthesis": [
        "save-synthesis.prompt.md"
      ],
      "business_analysis": [
        "business-analysis-doc.prompt.md"
      ],
      "system_analysis": [
        "system-analysis-doc.prompt.md"
      ],
      "system_design": [
        "system-design-doc.prompt.md"
      ],
      "notebooklm_export": [
        "export-notebooklm.prompt.md"
      ],
      "functional_exploration": [
        "functional-exploration.prompt.md"
      ],
      "visualize": [
        "visualize-wiki.prompt.md"
      ]
    },
    "codex": {
      "recipe_document": "Codex.md"
    }
  },
  "cli": {
    "install": "python .agents/skills/codebase-wiki/scripts/install-framework.py install --target TARGET --surface SURFACE --guard-mode wiki-only",
    "upgrade": "python .agents/skills/codebase-wiki/scripts/install-framework.py upgrade --target TARGET --surface SURFACE --guard-mode wiki-only"
  },
  "integrations": {
    "source_discovery": {
      "provider": "tgrep",
      "version": "1.0.5",
      "platforms": [
        "windows-x86_64"
      ],
      "operations": [
        "ingest",
        "archaeology"
      ],
      "fallback": "host-native-search",
      "index_policy": "existing-index-or-full-scan",
      "auto_index": false,
      "auto_serve": false,
      "exit_codes": {
        "match": 0,
        "no_match": 1,
        "error": 2
      },
      "writes": false,
      "query_enabled": false,
      "wrapper": ".agents/skills/codebase-wiki/scripts/tgrep-search.py",
      "manifest": ".agents/skills/codebase-wiki/bin/tgrep-manifest.json",
      "binary": ".agents/skills/codebase-wiki/bin/windows-x64/tgrep.exe",
      "sha256": "9b90e4446e2cbf05e1da086547501e35d7b32f0f6d5f687548cf270b07fbd9d7",
      "license": "MIT",
      "license_file": ".agents/skills/codebase-wiki/bin/windows-x64/LICENSE.txt",
      "upstream_release": "https://github.com/microsoft/tgrep/releases/tag/v1.0.5"
    },
    "project_scanner": {
      "provider": "host-native-filesystem",
      "version": "2",
      "operations": [
        "code_audit",
        "notebooklm_export",
        "functional_exploration",
        "ingest"
      ],
      "wrapper": ".agents/skills/codebase-wiki/scripts/scan-project.py",
      "module": ".agents/skills/codebase-wiki/scripts/project_scanner.py",
      "read_only": true,
      "scope": "explicit_project_root_and_descendants",
      "snapshot": "sha256",
      "entrypoint_candidates": true
    },
    "visualization": {
      "provider": "archify",
      "version": "3.2.0",
      "source_commit": "208acba8d412335185b2056fedf54b3405df43fb",
      "archive_sha256": "70e210265c59f24dcbdf2a502ff671104b5454e7ee7d3554aecd86bad32384f5",
      "manifest": ".agents/skills/codebase-wiki/vendor/archify-manifest.json",
      "manifest_sha256": "15c1b258d6958b964d4bf41f87e596e79ff5751cb438173c6b4f95bbad519509",
      "license": "MIT",
      "node_requirement": ">=18",
      "platforms": ["windows-x86_64"],
      "other_platforms": "not-yet-tested",
      "diagram_types": ["architecture", "workflow", "sequence", "dataflow", "lifecycle", "erd", "class", "tree", "timeline", "waterfall"],
      "update_check": "disabled",
      "auto_download": false,
      "wrapper": ".agents/skills/codebase-wiki/scripts/wiki-visualize.py",
      "workflow": ".agents/skills/codebase-wiki/references/visualization-workflow.md"
    }
  },
  "query_follow_up": {
    "reference": "references/follow-up-actions.md",
    "actions": [
      "reingest",
      "save-synthesis",
      "refresh-and-save",
      "lint",
      "none"
    ],
    "authorization": "one_selection_of_concrete_preview",
    "writes_before_selection": false,
    "repeat_confirmation": false
  }
}
