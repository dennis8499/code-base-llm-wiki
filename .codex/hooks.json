{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/skills/codebase-wiki/scripts/hooks/wiki-session-init.py --platform codex",
            "commandWindows": "python .agents\\skills\\codebase-wiki\\scripts\\hooks\\wiki-session-init.py --platform codex",
            "timeout": 10,
            "statusMessage": "Loading wiki state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|create|create_file|edit|editFiles|str_replace|str_replace_editor|multi_replace_string_in_file|replace_string_in_file|write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/skills/codebase-wiki/scripts/hooks/wiki-write-guard.py --platform codex",
            "commandWindows": "python .agents\\skills\\codebase-wiki\\scripts\\hooks\\wiki-write-guard.py --platform codex",
            "timeout": 10,
            "statusMessage": "Checking wiki write boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|create|create_file|edit|editFiles|str_replace|str_replace_editor|multi_replace_string_in_file|replace_string_in_file|write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/skills/codebase-wiki/scripts/hooks/wiki-log-reminder.py --platform codex",
            "commandWindows": "python .agents\\skills\\codebase-wiki\\scripts\\hooks\\wiki-log-reminder.py --platform codex",
            "timeout": 10,
            "statusMessage": "Checking wiki log reminder"
          }
        ]
      }
    ]
  }
}
