{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|create|create_file|edit|editFiles|str_replace|str_replace_editor|multi_replace_string_in_file|replace_string_in_file|write)$",
        "type": "command",
        "bash": "python3 .agents/skills/codebase-wiki/scripts/hooks/wiki-write-guard.py --platform copilot",
        "powershell": "python .agents/skills/codebase-wiki/scripts/hooks/wiki-write-guard.py --platform copilot",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
