{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "matcher": "startup|resume",
        "type": "command",
        "bash": "python3 .github/hooks/scripts/wiki-session-init.py",
        "powershell": "python .github/hooks/scripts/wiki-session-init.py",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
